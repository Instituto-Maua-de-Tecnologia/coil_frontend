{
    "jsc": {
        "parser": {
            "syntax": "typescript",
            "tsx": true
        },
        "target": "es2022",
        "transform": {
            "react": {
                "runtime": "automatic",
                "development": false,
                "refresh": true
            }
        },
        "minify": true
    },
    "module": {
        "type": "es2022",
        "strict": true,
        "strictMode": true
    }
}
